# Copy to .env (never commit .env). Hostnames are docker-compose service names;
# scripts run from your laptop use localhost defaults instead (see scripts/*.py).

# Platform database (Alembic-managed)
APP_DATABASE_URL=postgresql+psycopg://pixelvyne:pixelvyne@app-db:5432/pixelvyne

# Target sandbox where converted code runs
TARGET_DATABASE_URL=postgresql://sandbox:sandbox@target-db:5432/target

# Legacy source system
ORACLE_DSN=oracle:1521/FREEPDB1
ORACLE_USER=legacy
ORACLE_PASSWORD=legacy

# Celery broker/result backend + LLM cache
REDIS_URL=redis://redis:6379/0

# Gemini (get a key from Google AI Studio; check the model name is current)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Frontend dev server
CORS_ORIGINS=["http://localhost:5173"]
